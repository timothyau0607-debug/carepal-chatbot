# 二選一（皆未設定則 /api/chat 走本地 Demo ＋ 關鍵字 RAG）：
# — OpenRouter（建議用官方格式模型 id，如 openai/gpt-4o-mini）
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=CarePal Chatbot
# — 或直接 OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# RAG 向量匯入（npm run ingest:rag）與線上檢索共用上述金鑰。可選：
# EMBEDDING_MODEL=openai/text-embedding-3-small
# RAG_EXCEL_PATH=C:/path/失智ＱＡ.xlsx
# RAG_PDF_PATH=D:/path/失智100問.pdf
#
# 長期記憶（Supabase，僅伺服器讀寫，請勿把 Service Role 填進 NEXT_PUBLIC_）
# 建表：先 001，再 002（家屬／病者／醫護分開畫像），再 003、004（到院情境、醫護端今日摘錄表）
# supabase/migrations/001_carepal_memory.sql
# supabase/migrations/002_carepal_user_role.sql
# supabase/migrations/003_carepal_profile_extras.sql
# supabase/migrations/004_hospital_visit_staff_feed.sql
#
# 可選：每輪對話後以第二段 LLM 更新 inferred_profile。設 1 可關閉（省成本）
# CAREPAL_DISABLE_PROFILE_INFER=1
# 可選：畫像歸納專用模型 id（與主對話相同 provider／金鑰；未設定則與主模型相同）
# CAREPAL_PROFILE_INFER_MODEL=openai/gpt-4o-mini
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
